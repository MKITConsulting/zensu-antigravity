{
  "zensu-pre-tool": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash __ZENSU_HOME__/hooks/antigravity/antigravity-shim.sh pre-tool-chain.sh PreToolUse",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "zensu-pre-invocation": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash __ZENSU_HOME__/hooks/antigravity/antigravity-shim.sh pre-invocation-chain.sh PreInvocation",
        "timeout": 90
      }
    ]
  },
  "zensu-post-tool": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash __ZENSU_HOME__/hooks/antigravity/antigravity-shim.sh post-tool-chain.sh PostToolUse",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "zensu-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "bash __ZENSU_HOME__/hooks/antigravity/antigravity-shim.sh stop-chain.sh Stop",
        "timeout": 180
      }
    ]
  }
}
